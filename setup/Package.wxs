<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
    Name="CarthoCAD"
    Manufacturer="Gdiael Barros"
    Version="$(var.Version)"
    UpgradeCode="ADFA9DC2-D5E1-4B1F-84CC-A3AC9393C2E5"
    Scope="perUser">

    <SummaryInformation
      Description="CarthoCAD, Plugin para AutoCAD"
      Manufacturer="Gdiael Barros" />

    <MediaTemplate EmbedCab="yes" />

    <!-- Suprime warnings de ICE para instalação per-user -->
    <Property Id="MSIINSTALLPERUSER" Value="1" />
    <Property Id="ALLUSERS" Value="2" />

    <!-- Ícone no Add/Remove Programs -->
    <Icon Id="CarthoCADIcon" SourceFile="$(var.SourceDir)\Contents\Recursos\Carthocad.ico" />
    <Property Id="ARPPRODUCTICON" Value="CarthoCADIcon" />

    <StandardDirectory Id="AppDataFolder">
      <Directory Id="AutodeskFolder" Name="Autodesk">
        <Directory Id="ApplicationPluginsFolder" Name="ApplicationPlugins">
          <Directory Id="INSTALLFOLDER" Name="CarthoCAD.bundle" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <ui:WixUI Id="WixUI_Minimal" />

    <WixVariable Id="WixUILicenseRtf" Value="CarthoCAD.bundle\Contents\Recursos\Licença Carthocad.rtf" />

    <Feature Id="MainFeature" Title="CarthoCAD" Level="1" AllowAdvertise="no">
      <ComponentGroupRef Id="CarthoCADComponents" />
    </Feature>

  </Package>

</Wix>
