<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Package</OutputType>
    <OutputName>CarthoCAD_Installer</OutputName>
    <Version Condition="'$(Version)'==''">0.4.40</Version>
    <EnableProjectHarvesting>true</EnableProjectHarvesting>
    <SuppressIces>ICE38;ICE64</SuppressIces>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>SourceDir=$(MSBuildProjectDirectory)\CarthoCAD.bundle</DefineConstants>
    <DefineConstants Condition="'$(Version)'!=''">$(DefineConstants);Version=$(Version)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Heat" Version="5.0.2">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <HarvestDirectory Include="$(MSBuildProjectDirectory)\CarthoCAD.bundle">
      <ComponentGroupName>CarthoCADComponents</ComponentGroupName>
      <DirectoryRefId>INSTALLFOLDER</DirectoryRefId>
      <PreprocessorVariable>var.SourceDir</PreprocessorVariable>
      <SuppressCom>true</SuppressCom>
      <SuppressRegistry>true</SuppressRegistry>
      <SuppressRootDirectory>true</SuppressRootDirectory>
    </HarvestDirectory>
  </ItemGroup>

</Project>
